{
  "name": "today-is-deadline",
  "version": "0.1.0",
  "description": "타이핑 카운터 위젯",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "check": "biome check . && pnpm check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "dev": "electron-vite dev",
    "postinstall": "install-electron",
    "lint-staged": "lint-staged",
    "native:build": "cd native && napi build --platform --release",
    "native:test": "cargo test --manifest-path native/Cargo.toml",
    "package": "electron-vite build && electron-builder",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": "biome check --write",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@napi-rs/cli": "^3.10.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "sort-package-json": "^4.0.0",
    "steiger": "^0.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1"
}
